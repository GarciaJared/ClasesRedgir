---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Footer from "../components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import Brief from "../components/brief.astro";
import Whyus from "../components/whyus.astro";
import HowWeWork from "../components/HowWeWork.astro";
import Freeclass from "../components/freeclass.astro";
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
        <body>
                <Header />
                <main data-router></main>
                <Footer />

                <template id="home-template">
                        <Hero title="¡Conoce nuevas culturas a través de sus idiomas!" />
                        <Brief />
                        <Whyus />
                        <HowWeWork />
                        <Freeclass />
                </template>

                <template id="login-template">
                        <h1>Login</h1>
                        <form>
                                <label>
                                        Email
                                        <input type="email" name="email" required />
                                </label>
                                <label>
                                        Password
                                        <input type="password" name="password" required />
                                </label>
                                <button type="submit">Log In</button>
                        </form>
                        <style>
                                form {
                                        display: flex;
                                        flex-direction: column;
                                        gap: 1em;
                                        max-width: 400px;
                                        margin: auto;
                                }
                                label {
                                        display: flex;
                                        flex-direction: column;
                                        font-weight: bold;
                                }
                                input {
                                        padding: 0.5em;
                                }
                                button {
                                        padding: 0.5em 1em;
                                        background: #456A89;
                                        color: white;
                                        border: none;
                                        cursor: pointer;
                                }
                        </style>
                </template>

                <script type="module" src="/router.js"></script>
                <script type="module" src="/main.js"></script>
        </body></html>